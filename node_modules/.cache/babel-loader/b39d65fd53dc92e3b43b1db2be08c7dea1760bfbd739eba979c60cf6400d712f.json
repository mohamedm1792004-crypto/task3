            >\r\n                            Fragrances\r\n                        </button>\r\n                    </li>\r\n\r\n                    <li>\r\n                        <button\r\n                            className={search === \"furniture\" ? \"is_active\" : \"\"}\r\n                            onClick={() => getValue(\"furniture\")}\r\n                        >\r\n                            Furniture\r\n                        </button>\r\n                    </li>\r\n\r\n                </ul>\r\n\r\n                <div className=\"row properties-box\">\r\n\r\n                    {data.map((item) => {\r\n\r\n                        console.log(item.category, search)\r\n\r\n                        return search === \"all\" ? (\r\n\r\n                            <div\r\n                                className=\"col-lg-4 col-md-6 align-self-center mb-30 properties-items col-md-6 adv\"\r\n                                key={item.id}\r\n                            >\r\n                                <div className=\"item\">\r\n\r\n                                    <Link to={`/singleproduct/${item.id}`}>\r\n                                        <img src={item.images[0]} alt=\"\" />\r\n                                    </Link>\r\n\r\n                                    <span className=\"category\">\r\n                                        {item.category}\r\n                                    </span>\r\n\r\n                                    <h6>{item.price}</h6>\r\n\r\n                                    <h4>\r\n                                        <Link to={`/singleproduct/${item.id}`}>\r\n                                            {item.title}\r\n                                        </Link>\r\n                                    </h4>\r\n\r\n                                    <ul>\r\n                                        <li>\r\n                                            Brand: <span>{item.brand}</span>\r\n                                        </li>\r\n\r\n                                        <li>\r\n                                            stock: <span>{item.stock}</span>\r\n                                        </li>\r\n\r\n                                        <li>\r\n                                            id: <span>{item.id}</span>\r\n                                        </li>\r\n                                    </ul>\r\n\r\n                                    <div className=\"main-button\">\r\n                                        <Link to={`/singleproduct/${item.id}`}>\r\n                                            Details\r\n                                        </Link>\r\n                                        <button onClick={() => addToCart(item)}>add to cart</button>\r\n                                    </div>\r\n\r\n                                </div>\r\n                            </div>\r\n\r\n                        ) : item.category === search ? (\r\n\r\n                            <div\r\n                                className=\"col-lg-4 col-md-6 align-self-center mb-30 properties-items col-md-6 adv\"\r\n                                key={item.id}\r\n                            >\r\n                                <div className=\"item\">\r\n\r\n                                    <Link to={`/singleproduct/${item.id}`}>\r\n                                        <img src={item.images[0]} alt=\"\" />\r\n                                    </Link>\r\n\r\n                                    <span className=\"category\">\r\n                                        {item.category}\r\n                                    </span>\r\n\r\n                                    <h6>{item.price}</h6>\r\n\r\n                                    <h4>\r\n                                        <Link to={`/singleproduct/${item.id}`}>\r\n                                            {item.title}\r\n                                        </Link>\r\n          